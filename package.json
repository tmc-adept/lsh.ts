{
  "name": "lsh.ts",
  "version": "0.1.1",
  "description": "TypeScript implementation of MinHash signatures and a Locality Sensitive Hashing index.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "examples": "bun run examples/index.ts",
    "lint": "oxlint src tests examples",
    "lint:fix": "oxlint --fix src tests examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "minhash",
    "locality-sensitive-hashing",
    "lsh",
    "similarity",
    "typescript"
  ],
  "author": "xwxfox",
  "repository": {
    "type": "git",
    "url": "https://github.com/xwxfox/lsh.ts.git"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.17"
  },
  "packageManager": ">=bun@1.1.3",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "oxlint": "^0.3.3",
    "typescript": "^5.3.3",
    "vitest": "^1.1.1"
  }
}
